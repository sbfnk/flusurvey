linters: linters_with_tags(
    tags = NULL, # include all linters
    implicit_integer_linter = NULL,
    keyword_quote_linter = NULL,
    function_argument_linter = NULL,
    object_name_linter = NULL,
    undesirable_function_linter = NULL, # allow structure(), library(), message()
    nonportable_path_linter = NULL, # flags regular expressions; the package builds no paths
    object_overwrite_linter = object_overwrite_linter(allow_names = "dt")
  )
exclusions: c(
    list.files("tests", recursive = TRUE, full.names = TRUE),
    list.files("inst", recursive = TRUE, full.names = TRUE),
    list.files("vignettes", recursive = TRUE, full.names = TRUE),
    "README.Rmd"
  )
